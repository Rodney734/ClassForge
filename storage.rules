rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /assignments/{level}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /submissions/{assignmentId}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
